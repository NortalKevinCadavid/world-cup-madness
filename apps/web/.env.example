# --------------------------------------------------------------------------
# -- DEV-ONLY: not used in any production environment
# --------------------------------------------------------------------------
# World Cup Madness — Next.js (apps/web) environment template.
# Copy to `.env.local` (gitignored) and adjust as needed:
#
#     cp apps/web/.env.example apps/web/.env.local
#
# The OIDC stub env vars below point at the local fake-IdP sidecar declared
# in `../../docker-compose.override.yml`. Production deployments DO NOT use
# these — they configure Microsoft Entra ID via the
# [auth.external.azure] block in `supabase/config.toml` instead. See
# `infra/oidc-stub/README.md` and
# `specs/001-eligibility-login/research.md` § R-001 for context.
# --------------------------------------------------------------------------

# Supabase local stack — defaults from `supabase status` on a fresh `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_REPLACE_VIA_supabase_status

# --------------------------------------------------------------------------
# OIDC stub (LOCAL / CI ONLY — replaced by Microsoft Entra ID in prod).
# --------------------------------------------------------------------------
# `SUPABASE_AUTH_OIDC_ISSUER` is the URL the Supabase Auth container resolves
# to reach the Keycloak sidecar. From inside the Supabase container,
# `host.docker.internal` resolves to the host machine; from the host browser,
# use `http://localhost:8090/realms/default` instead (the port mapping makes
# both addresses reach the same Keycloak instance and discovery returns the
# same URL set). Keycloak realm paths are always `/realms/<realm-name>/...`.
SUPABASE_AUTH_OIDC_ISSUER=http://host.docker.internal:8090/realms/default

# Audience must match the `client_id` registered with the stub; tests assert
# on this value when verifying issued JWTs.
SUPABASE_AUTH_OIDC_AUDIENCE=world-cup-madness-local

# Client credentials registered with the stub. The stub accepts ANY client
# id/secret pair by default, so these are pure-dev constants used to wire
# Supabase Auth ↔ stub. Never reuse this secret outside dev/CI.
SUPABASE_AUTH_OIDC_CLIENT_ID=world-cup-madness-local
SUPABASE_AUTH_OIDC_CLIENT_SECRET=dev-only-do-not-reuse

# --------------------------------------------------------------------------
# Production-only vars — left blank in dev; configured per-deployment.
# --------------------------------------------------------------------------
# Microsoft Entra ID secret (FR-001 production path). Read by Supabase Auth
# via `env(...)` substitution in `supabase/config.toml`.
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
